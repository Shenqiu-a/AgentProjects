<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version><relativePath/>
    </parent>
    <groupId>com.example</groupId><artifactId>after-sales-services</artifactId><version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging><name>after-sales-services</name>
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-ai.version>2.0.1</spring-ai.version><pdfbox.version>3.0.8</pdfbox.version>
    </properties>
    <modules>
        <module>service-common</module><module>auth-service</module><module>order-service</module>
        <module>knowledge-service</module><module>agent-service</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example</groupId><artifactId>service-common</artifactId><version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId><artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version><type>pom</type><scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
