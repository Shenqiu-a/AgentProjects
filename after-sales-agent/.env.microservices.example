# Copy to .env.microservices. Scripts read this file; do not commit credentials.
SERVICE_AUTH_TOKEN=replace-with-a-random-secret-at-least-32-characters
AUTH_DATABASE_PASSWORD=replace-with-auth-database-password
ORDER_DATABASE_PASSWORD=replace-with-order-database-password
KNOWLEDGE_DATABASE_PASSWORD=replace-with-knowledge-database-password
AGENT_DATABASE_PASSWORD=replace-with-agent-database-password
REDIS_PASSWORD=replace-with-redis-password
GATEWAY_PORT=8080
# Local IDE defaults; Compose overrides container addresses.
AUTH_DATABASE_URL=jdbc:postgresql://127.0.0.1:55431/after_sales_auth
AUTH_DATABASE_USERNAME=after_sales_auth
ORDER_DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/after_sales_order
ORDER_DATABASE_USERNAME=after_sales_order
KNOWLEDGE_DATABASE_URL=jdbc:postgresql://127.0.0.1:55433/after_sales_knowledge
KNOWLEDGE_DATABASE_USERNAME=after_sales_knowledge
AGENT_DATABASE_URL=jdbc:postgresql://127.0.0.1:55434/after_sales_agent
AGENT_DATABASE_USERNAME=after_sales_agent
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
AUTH_SERVICE_URL=http://127.0.0.1:8081
MODEL_MODE=mock
SESSION_COOKIE_SECURE=false
