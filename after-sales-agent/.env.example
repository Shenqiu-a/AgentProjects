# 复制为项目根目录 .env 后填写。
# 本地 Spring Boot 从 backend 工作目录显式按 Java Properties 格式读取此文件；
# Docker Compose 从项目根目录读取 .env。
# 共用语法：KEY=value；不加 export，不给值加引号，不在值后写行尾注释；路径使用正斜杠。
# 两种读取器的转义/插值规则不同；包含 $、反斜杠或特殊语法的凭证请改用系统环境变量。
# 系统环境变量的值优先。不得提交真实 .env。

POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg17-bookworm
POSTGRES_PORT=5432
POSTGRES_DB=after_sales
DATABASE_HOST=localhost
DATABASE_USERNAME=after_sales
DATABASE_PASSWORD=replace_with_your_own_password
# 可选：连接外部 PostgreSQL 时取消注释并修改，优先于主机/端口/库名组合。
# DATABASE_URL=jdbc:postgresql://localhost:5432/after_sales

EVAL_POSTGRES_PORT=15433
EVAL_DATABASE_USERNAME=after_sales_eval
EVAL_DATABASE_PASSWORD=replace_with_your_own_password
# EVAL_DATABASE_URL=jdbc:postgresql://localhost:15433/after_sales_eval
EVAL_SERVER_PORT=8081

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
MODEL_MODE=mock
INDEX_NAMESPACE=mock-v1

# 以下预留给真实模型接入；当前只有核心接口依赖，尚无 provider 实现。
CHAT_PROVIDER=unconfigured
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
EMBEDDING_PROVIDER=unconfigured
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 0=尚未选择真实模型；mock 维度单独配置为 16。
EMBEDDING_DIMENSIONS=0

# 评测模式单独配置，不能因在线 MODEL_MODE 改成 live 就跟着产生模型费用。
EVAL_MODEL_MODE=mock
EVAL_INDEX_NAMESPACE=eval-mock-v1
EVAL_ALLOW_LIVE=false

# 以下相对路径以 backend 工作目录为基准。
UPLOAD_ROOT=../data/uploads
LOG_FILE=../data/logs/after-sales-agent.log
EVAL_UPLOAD_ROOT=../data/eval/uploads
EVAL_LOG_FILE=../data/eval/logs/after-sales-agent-eval.log
